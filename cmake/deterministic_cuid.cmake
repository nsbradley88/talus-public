# Deterministic HIP compilation-unit IDs (talus#45 reproducibility, build-cache hygiene).
#
# clang's default CUID (-fuse-cuid=hash) hashes the input path and the whole driver argument list. The CUID names a
# per-TU symbol (__hip_cuid_<hex>) in the host object and the device code object, and its printed length varies (no
# leading zeros), which shifts code-object sections and with them PC-relative string offsets in device code. Any
# change to the argv (worktree path, ccache reordering arguments or adding -fcolor-diagnostics) therefore changed
# device code bytes. Here every HIP source gets -cuid=<16 hex> = MD5("<source tree tag>/<path relative to that tree>"):
# stable across hosts, worktree paths, compiler caches and the release container, and distinct per source file, so
# static device symbols stay unique across translation units. (A file compiled into two targets gets the same CUID in
# both, as it would have the same other globals; source properties are per directory anyway.) Kill switch: -DSTRATA_DETERMINISTIC_CUID=OFF.
option(STRATA_DETERMINISTIC_CUID "Per-file deterministic HIP -cuid (path relative to the source tree)" ON)

function(_talus_cuid_collect_dirs _dir _out)
  set(_all "${_dir}")
  get_property(_subs DIRECTORY "${_dir}" PROPERTY SUBDIRECTORIES)
  foreach(_s IN LISTS _subs)
    _talus_cuid_collect_dirs("${_s}" _sub_all)
    list(APPEND _all ${_sub_all})
  endforeach()
  set(${_out} ${_all} PARENT_SCOPE)
endfunction()

function(talus_apply_deterministic_cuid)
  if(NOT STRATA_DETERMINISTIC_CUID OR NOT CMAKE_HIP_COMPILER_LOADED)
    return()
  endif()
  # Source roots, most specific first: the ggml tree (FetchContent / STRATA_GGML_DIR), then this repo, then the build dir.
  set(_roots "")
  foreach(_r IN ITEMS "${STRATA_GGML_DIR}" "${strata_llamacpp_SOURCE_DIR}")
    if(_r)
      get_filename_component(_r "${_r}" REALPATH)
      list(APPEND _roots "ggml-src=${_r}")
    endif()
  endforeach()
  get_filename_component(_src "${CMAKE_SOURCE_DIR}" REALPATH)
  get_filename_component(_bin "${CMAKE_BINARY_DIR}" REALPATH)
  list(APPEND _roots "src=${_src}" "bin=${_bin}")

  _talus_cuid_collect_dirs("${CMAKE_SOURCE_DIR}" _dirs)
  set(_n 0)
  foreach(_d IN LISTS _dirs)
    get_property(_targets DIRECTORY "${_d}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_t IN LISTS _targets)
      get_target_property(_type ${_t} TYPE)
      if(_type STREQUAL "INTERFACE_LIBRARY" OR _type STREQUAL "UTILITY")
        continue()
      endif()
      get_target_property(_srcs ${_t} SOURCES)
      get_target_property(_sdir ${_t} SOURCE_DIR)
      if(NOT _srcs)
        continue()
      endif()
      foreach(_s IN LISTS _srcs)
        if(_s MATCHES "^\\$<")          # generator expressions: not resolvable here
          continue()
        endif()
        if(IS_ABSOLUTE "${_s}")
          set(_abs "${_s}")
        else()
          set(_abs "${_sdir}/${_s}")
        endif()
        get_source_file_property(_lang "${_abs}" TARGET_DIRECTORY ${_t} LANGUAGE)
        if(NOT _lang STREQUAL "HIP")
          continue()
        endif()
        get_filename_component(_real "${_abs}" REALPATH)
        set(_rel "")
        foreach(_root IN LISTS _roots)
          string(REGEX MATCH "^([^=]*)=(.*)$" _m "${_root}")
          set(_tag "${CMAKE_MATCH_1}")
          set(_rp "${CMAKE_MATCH_2}")
          string(FIND "${_real}" "${_rp}/" _pos)
          if(_pos EQUAL 0)
            file(RELATIVE_PATH _r "${_rp}" "${_real}")
            set(_rel "${_tag}/${_r}")
            break()
          endif()
        endforeach()
        if(NOT _rel)
          get_filename_component(_rel "${_real}" NAME)
          set(_rel "other/${_rel}")
        endif()
        get_source_file_property(_opts "${_abs}" TARGET_DIRECTORY ${_t} COMPILE_OPTIONS)
        if(_opts MATCHES "-cuid=")       # already set (same file in another target of this directory)
          continue()
        endif()
        string(MD5 _h "${_rel}")
        string(SUBSTRING "${_h}" 0 16 _cuid)
        set_property(SOURCE "${_abs}" TARGET_DIRECTORY ${_t} APPEND PROPERTY COMPILE_OPTIONS "-cuid=${_cuid}")
        math(EXPR _n "${_n} + 1")
      endforeach()
    endforeach()
  endforeach()
  message(STATUS "Talus: deterministic HIP CUIDs on ${_n} target sources")
endfunction()

# Path-independent __FILE__ (same goal): __FILE__ strings end up in device code (ggml's no_device_code / assert
# messages) and host .rodata, so a build in another worktree, or one whose compiler cache handed clang relative paths
# (ccache base_dir), produced different bytes. Map each source tree to a fixed tag, both as the absolute path (plain
# builds) and as the path relative to the build directory (what ccache's base_dir rewriting gives clang; ninja runs the
# compiler from CMAKE_BINARY_DIR). gcc uses the last matching map, clang the longest: most specific tree last. Kill switch: -DSTRATA_REPRO_PATHS=OFF.
option(STRATA_REPRO_PATHS "Map source-tree prefixes in __FILE__ to fixed tags (-fmacro-prefix-map)" ON)

function(talus_apply_repro_paths)
  if(NOT STRATA_REPRO_PATHS)
    return()
  endif()
  set(_maps "")
  # Most specific tree LAST: gcc applies the last matching -fmacro-prefix-map, clang the longest; this repo's
  # relative form ("../") is a prefix of the ggml tree's ("../../talus-deps/..."), so ggml goes after it.
  set(_pairs "src|${CMAKE_SOURCE_DIR}")
  foreach(_r IN ITEMS "${STRATA_GGML_DIR}" "${strata_llamacpp_SOURCE_DIR}")
    if(_r)
      list(APPEND _pairs "ggml-src|${_r}")
    endif()
  endforeach()
  foreach(_p IN LISTS _pairs)
    string(REGEX MATCH "^([^|]*)\\|(.*)$" _m "${_p}")
    set(_tag "${CMAKE_MATCH_1}")
    set(_given "${CMAKE_MATCH_2}")          # copy: later string(REGEX ...) calls reset CMAKE_MATCH_*
    get_filename_component(_abs "${_given}" REALPATH)
    file(RELATIVE_PATH _rel "${CMAKE_BINARY_DIR}" "${_abs}")
    string(REGEX REPLACE "/+$" "" _rel "${_rel}")   # RELATIVE_PATH may end in "/" (e.g. "../")
    if(NOT _given STREQUAL _abs)
      list(APPEND _maps "-fmacro-prefix-map=${_given}/=${_tag}/")
    endif()
    list(APPEND _maps "-fmacro-prefix-map=${_abs}/=${_tag}/")
    if(_rel AND NOT _rel STREQUAL ".")
      list(APPEND _maps "-fmacro-prefix-map=${_rel}/=${_tag}/")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _maps)
  # ccache (4.11, base_dir set) leaves -fmacro-prefix-map out of its hash, so a cached object compiled under another
  # map scheme could be served. A define that names the scheme (tags + build-dir-relative forms: the same in every
  # worktree of this layout) keeps the cache key honest; bump the "v" when the scheme changes.
  set(_spec "v1")
  foreach(_mp IN LISTS _maps)
    if(NOT _mp MATCHES "=/")             # absolute forms differ per worktree; the relative ones name the scheme
      string(APPEND _spec ";${_mp}")
    endif()
  endforeach()
  string(MD5 _id "${_spec}")
  string(SUBSTRING "${_id}" 0 12 _id)
  list(APPEND _maps "-DSTRATA_REPRO_PATHS_ID=${_id}")
  _talus_cuid_collect_dirs("${CMAKE_SOURCE_DIR}" _dirs)
  set(_n 0)
  foreach(_d IN LISTS _dirs)
    get_property(_targets DIRECTORY "${_d}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_t IN LISTS _targets)
      get_target_property(_type ${_t} TYPE)
      if(_type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
        foreach(_mp IN LISTS _maps)
          target_compile_options(${_t} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX,HIP>:${_mp}>")
        endforeach()
        math(EXPR _n "${_n} + 1")
      endif()
    endforeach()
  endforeach()
  message(STATUS "Talus: __FILE__ prefix maps on ${_n} targets: ${_maps}")
endfunction()
